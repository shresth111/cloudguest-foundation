# Copy to .env and adjust before `docker compose build`.
#
# Baked into the client bundle at build time (Vite inlines import.meta.env.
# VITE_* values during `bun run build`) -- changing this after a build
# requires a rebuild, not just a container restart.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo login (admin@example.com / test) -- mints a Super Admin session in the
# browser with no backend involvement. Leave unset in production; set to
# "true" only for a demo or local build. Without it the production bundle
# still enables the demo on demo.wyfyguest.com (and demo.localhost) only --
# see src/lib/demo-host.ts.
VITE_ENABLE_DEMO_LOGIN=false
